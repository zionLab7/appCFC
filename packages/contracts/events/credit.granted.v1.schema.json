{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gp-cfc.local/schemas/events/credit.granted.v1.json",
  "type":"object","additionalProperties":false,
  "required":["walletId","enrollmentId","entryId","itemType","quantity"],

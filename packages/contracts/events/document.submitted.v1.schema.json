{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gp-cfc.local/schemas/events/document.submitted.v1.json",
  "type":"object","additionalProperties":false,
  "required":["id","version","sha256","sizeBytes","mimeType"],
  "properties":{
    "id":{"type":"string","format":"uuid"},"version":{"type":"integer","minimum":1},
    "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "sizeBytes":{"type":"integer","minimum":1,"maximum":5000000},
    "mimeType":{"type":"string","enum":["application/pdf","image/png","image/jpeg"]}
  }
}

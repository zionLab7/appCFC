{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gp-cfc.local/schemas/events/payment.received.v1.json",
  "type":"object","additionalProperties":false,
  "required":["paymentId","amountCents","currency","method","allocationIds"],
  "properties":{
    "paymentId":{"type":"string","format":"uuid"},"amountCents":{"type":"integer","minimum":1},
    "currency":{"const":"BRL"},"method":{"type":"string"},
    "allocationIds":{"type":"array","items":{"type":"string","format":"uuid"}}
  }
}
